{
  "name": "@szewtwin/viewer-react",
  "version": "5.0.1",
  "description": "Configurable szewTwin.js viewer",
  "type": "module",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "author": {
    "name": "Szewec Systems, Inc.",
    "url": "http://www.szewec.com"
  },
  "license": "MIT",
  "repository": "https://github.com/szewtwin/viewer/tree/main/packages/modules/viewer-react",
  "scripts": {
    "start": "npm:build -- -w",
    "build": "npm run build:esm && npm run copy-public",
    "build:esm": "tsc 1>&2 --outDir lib",
    "copy-public": "copyfiles -u1 \"./public/**/*\" ./lib/public",
    "test": "vitest run",
    "test-watch": "vitest",
    "clean": "rimraf lib",
    "rebuild": "npm run clean && npm run build",
    "lint": "eslint \"src/**/*.ts*\"  1>&2",
    "lint:fix": "npm run -s lint -- --fix"
  },
  "dependencies": {
